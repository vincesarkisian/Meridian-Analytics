WORKOS_CLIENT_ID=
WORKOS_API_KEY=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
WORKOS_COOKIE_PASSWORD=


# Demo: the Acme organization id, used by /login/sso to scope sign-in to Acme for the SSO demo
DEMO_ACME_ORG_ID=

# Demo: the Prospect org id (stricter 24h session + MFA policy, Requirement 5)
DEMO_PROSPECT_ORG_ID=
# Optional: expire Prospect-org sessions after N seconds (default 24h = 86400).
# Read in src/lib/session-policy.ts; set it in Vercel to change the deployed limit.
# PROSPECT_SESSION_MAX_SECONDS=10

# Bonus: Slack notifications on seat changes via WorkOS Pipes
# Channel to notify (channel ID like C01234ABC, or #customer-success)
SLACK_CUSTOMER_SUCCESS_CHANNEL=
# Signing secret from the WorkOS dashboard Webhooks endpoint
WORKOS_WEBHOOK_SECRET=
# User id whose connected Slack account the webhook posts as (the admin who connected Slack)
DEMO_SLACK_ADMIN_USER_ID=
